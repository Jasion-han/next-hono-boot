# ============================================
# 开发环境配置示例（可提交到 Git）
# ============================================
# 使用方式：
# 1) 复制为 .env.development
# 2) 按你的本机环境修改
# ============================================

# 数据库配置
DATABASE_URL="mysql://USER:PASSWORD@127.0.0.1:3306/next_hono_boot"

# 开发环境自动迁移/种子（按需）
AUTO_DB_MIGRATE=true
AUTO_DB_SEED=true

# JWT 配置
JWT_SECRET="replace-with-a-local-dev-secret-at-least-32-chars"
JWT_EXPIRES_IN="30d"
