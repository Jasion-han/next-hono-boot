# ============================================
# 生产环境配置示例（可提交到 Git）
# ============================================
# 使用方式：
# 1) 复制为 .env.production.local（推荐，不提交到 Git）
#    或复制为 .env.production（如果你确定不会提交）
# 2) 填写真实生产配置
# ============================================

# 数据库配置
DATABASE_URL="mysql://USER:PASSWORD@127.0.0.1:3306/next_hono_boot"
DATABASE_MAX_CONNECTIONS=20
DATABASE_IDLE_TIMEOUT=30
DATABASE_CONNECT_TIMEOUT=10

# 是否自动迁移/种子（生产通常建议谨慎开启）
AUTO_DB_MIGRATE=false
AUTO_DB_SEED=false

# JWT 配置
JWT_SECRET="replace-with-a-production-secret-at-least-32-chars"
JWT_EXPIRES_IN="7d"
